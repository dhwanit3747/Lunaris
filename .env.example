# ── Frontend environment variables ──────────────────────────────────────────
# Copy this file to .env.local for local overrides (never commit .env.local)
#
# VITE_API_URL is the full URL of the deployed CLPS FastAPI backend.
# Leave it unset (or delete the line) during local development —
# the Vite dev-server proxy will forward /api/* to http://127.0.0.1:8000.
#
# Production example (Railway):
VITE_API_URL=https://your-lunaris-api.railway.app

# JWT secret must match the LUNARIS_JWT_SECRET set on the backend server.
# (Frontend only reads JWTs; it does NOT use this key directly.)
# LUNARIS_JWT_SECRET=change-me-in-production

